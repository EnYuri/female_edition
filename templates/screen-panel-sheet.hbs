<div class="tab fe-sp-sheet{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <section class="fe-sp-settings">
    <div class="fe-sp-field fe-sp-field-name">
      <label>{{localize "FESP.Sheet.PanelName"}}</label>
      <input type="text" class="fe-sp-name-input" value="{{fe.actorName}}" placeholder="{{localize "FESP.Sheet.PanelNamePh"}}" {{#unless fe.editable}}disabled{{/unless}}>
    </div>
    <div class="fe-sp-field">
      <label>{{localize "FESP.Sheet.DefaultFace"}}</label>
      <select name="system.defaultFace" {{#unless fe.editable}}disabled{{/unless}}>
        {{#each fe.faces as |face|}}
          <option value="{{face.index}}" {{#if (eq face.index ../fe.defaultFace)}}selected{{/if}}>
            {{#if face.name}}{{face.name}}{{else}}{{localize "FESP.Sheet.FaceN" n=face.num}}{{/if}}
          </option>
        {{/each}}
      </select>
    </div>
    {{!-- 설명문은 인라인 <p class="notes"> 가 아니라 호버 툴팁이다. 두 힌트의 길이가
          크게 달라(위치 고정 쪽이 거의 두 배) 그리드 두 칸의 높이를 벌려 놓았고,
          켜고 끄기만 하면 되는 토글 옆에 세 줄짜리 문단은 과했다.
          코어 TooltipManager 는 포인터가 '들어간 바로 그 엘리먼트'의 dataset 만
          읽으므로(tooltip-manager.mjs #onActivate, capture 단계 pointerenter),
          label 과 checkbox 양쪽에 모두 달아야 한다 — label 에만 달면 정작 체크박스
          위에서는 뜨지 않는다. data-tooltip-text 는 평문 그대로 쓰이고 로컬라이즈되지
          않으므로(같은 파일 :258) 여기서 localize 한다. --}}
    <div class="fe-sp-field fe-sp-field-checkbox">
      <label data-tooltip-text="{{localize "FESP.Sheet.LockedHint"}}">
        <input type="checkbox" name="system.locked" data-tooltip-text="{{localize "FESP.Sheet.LockedHint"}}" {{checked fe.locked}} {{#unless fe.editable}}disabled{{/unless}}>
        {{localize "FESP.Sheet.Locked"}}
      </label>
    </div>
    <div class="fe-sp-field fe-sp-field-checkbox">
      <label data-tooltip-text="{{localize "FESP.Sheet.DblclickCycleHint"}}">
        <input type="checkbox" name="system.dblclickCycle" data-tooltip-text="{{localize "FESP.Sheet.DblclickCycleHint"}}" {{checked fe.dblclickCycle}} {{#unless fe.editable}}disabled{{/unless}}>
        {{localize "FESP.Sheet.DblclickCycle"}}
      </label>
    </div>
  </section>

  {{!-- Face switcher. The thumbnail is the point: faces are images, and "2면"/"3면"
        alone made you click through them to find the one you meant. The star marks
        the panel's default face so it is identifiable without opening the select. --}}
  <nav class="fe-sp-face-tabs">
    {{#each fe.faces as |face|}}
      <button type="button" class="fe-sp-face-tab{{#if face.active}} active{{/if}}"
              data-action="feSwitchFace" data-index="{{face.index}}"
              title="{{#if face.name}}{{face.name}}{{else}}{{localize "FESP.Sheet.FaceN" n=face.num}}{{/if}}{{#if face.isDefault}} · {{localize "FESP.Sheet.DefaultFaceMark"}}{{/if}}">
        {{!-- 이미지가 없는 면도 같은 크기의 썸네일 칸을 갖는다. 예전에는 이미지가 있는
              면에만 칸이 생겨서, 어두운 아트를 쓴 면 하나만 레이블 왼쪽에 정체불명의
              여백이 있는 것처럼 보였다(실측: 1면 82px / 2면 41px). --}}
        {{#if face.img}}<img class="fe-sp-face-tab-thumb" src="{{face.img}}" alt="">
        {{else}}<span class="fe-sp-face-tab-thumb fe-sp-face-tab-thumb-empty"><i class="fa-regular fa-image"></i></span>{{/if}}
        <span class="fe-sp-face-tab-label">{{#if face.name}}{{face.name}}{{else}}{{localize "FESP.Sheet.FaceN" n=face.num}}{{/if}}</span>
        {{#if face.isDefault}}<i class="fa-solid fa-star fe-sp-face-tab-default"></i>{{/if}}
      </button>
    {{/each}}
    {{#if fe.editable}}
      <button type="button" class="fe-sp-face-tab fe-sp-face-tab-add" data-action="feAddFace"
              title="{{localize "FESP.Sheet.AddFace"}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    {{/if}}
  </nav>

  {{#unless fe.faceCount}}
    <div class="fe-sp-empty">
      <i class="fa-regular fa-images"></i>
      <p class="fe-sp-empty-title">{{localize "FESP.Sheet.NoFaces"}}</p>
      <p class="notes">{{localize "FESP.Sheet.NoFacesHint"}}</p>
      {{#if fe.editable}}
        <button type="button" class="fe-sp-btn" data-action="feAddFace">
          <i class="fa-solid fa-plus"></i> {{localize "FESP.Sheet.AddFace"}}
        </button>
      {{/if}}
    </div>
  {{/unless}}

  <ol class="fe-sp-faces">
    {{#each fe.faces as |face|}}
      <li class="fe-sp-face{{#if face.active}} active{{/if}}" data-index="{{face.index}}">
        <div class="fe-sp-face-thumb" data-face-index="{{face.index}}" title="{{localize "FESP.Sheet.FaceThumbDropHint"}}">
          {{#if face.img}}<img src="{{face.img}}" alt="">{{/if}}
        </div>
        <div class="fe-sp-face-body">
          <div class="fe-sp-face-row">
            <span class="fe-sp-face-num">{{localize "FESP.Sheet.FaceN" n=face.num}}</span>
            <input type="text" name="system.faces.{{face.index}}.name"
                   value="{{face.name}}" placeholder="{{localize "FESP.Sheet.FaceNamePh"}}"
                   {{#unless ../fe.editable}}disabled{{/unless}}>
            {{#if ../fe.editable}}
              <span class="fe-sp-face-actions">
                <a data-action="feDuplicateFace" data-index="{{face.index}}" title="{{localize "FESP.Sheet.DuplicateFace"}}"><i class="fa-solid fa-clone"></i></a>
                <a data-action="feMoveFaceUp" data-index="{{face.index}}" title="{{localize "FESP.Sheet.MoveUp"}}"><i class="fa-solid fa-arrow-up"></i></a>
                <a data-action="feMoveFaceDown" data-index="{{face.index}}" title="{{localize "FESP.Sheet.MoveDown"}}"><i class="fa-solid fa-arrow-down"></i></a>
                <a data-action="feRemoveFace" data-index="{{face.index}}" title="{{localize "FESP.Sheet.RemoveFace"}}"><i class="fa-solid fa-trash"></i></a>
              </span>
            {{/if}}
          </div>
          <file-picker class="fe-sp-face-image-picker" data-face-index="{{face.index}}"
                       name="system.faces.{{face.index}}.img" type="image" value="{{face.img}}"
                       {{#unless ../fe.editable}}disabled{{/unless}}></file-picker>
          <div class="fe-sp-face-size-row">
            <label>
              <span>{{localize "FESP.Sheet.FaceWidth"}}</span>
              <input type="number" name="system.faces.{{face.index}}.width"
                     value="{{face.width}}" min="1" step="1"
                     {{#unless ../fe.editable}}disabled{{/unless}}>
            </label>
            <label>
              <span>{{localize "FESP.Sheet.FaceHeight"}}</span>
              <input type="number" name="system.faces.{{face.index}}.height"
                     value="{{face.height}}" min="1" step="1"
                     {{#unless ../fe.editable}}disabled{{/unless}}>
            </label>
            <span class="notes">{{localize "FESP.Sheet.FaceSizeHint"}}</span>
          </div>
          <textarea name="system.faces.{{face.index}}.description" rows="2"
                    placeholder="{{localize "FESP.Sheet.DescPh"}}"
                    {{#unless ../fe.editable}}disabled{{/unless}}>{{face.description}}</textarea>
          <input type="hidden" name="system.faces.{{face.index}}.linkedActorUuid" value="{{face.linkedActorUuid}}">
          {{!-- Per-face Token settings. data-dtype="JSON" round-trips the object through the
                faces-array auto-submit (FormDataExtended JSON.parses it) — without this the
                face's token settings reset on every unrelated edit. --}}
          <input type="hidden" name="system.faces.{{face.index}}.token" data-dtype="JSON" value="{{face.tokenJson}}">

          {{#if ../fe.tokenize}}
            <div class="fe-sp-face-token-row">
              <button type="button" class="fe-sp-btn" data-action="feEditFaceToken" data-index="{{face.index}}"
                      {{#unless ../fe.editable}}disabled{{/unless}}>
                <i class="fa-solid fa-chess-pawn"></i> {{localize "FESP.Sheet.FaceTokenEdit"}}
              </button>
              {{#if face.tokenConfigured}}
                <a data-action="feClearFaceToken" data-index="{{face.index}}"
                   title="{{localize "FESP.Sheet.FaceTokenClear"}}"><i class="fa-solid fa-rotate-left"></i></a>
                <span class="notes">{{localize "FESP.Sheet.FaceTokenSet"}}</span>
              {{else}}
                <span class="notes">{{localize "FESP.Sheet.FaceTokenUnset"}}</span>
              {{/if}}
            </div>
          {{/if}}
          {{!-- Copied per-face attributes: hidden inputs keep the faces-array auto-submit complete (edited live in the Attributes tab). --}}
          {{#each face.attributes as |fa|}}
            <input type="hidden" name="system.faces.{{face.index}}.attributes.{{fa.index}}.name" value="{{fa.name}}">
            <input type="hidden" name="system.faces.{{face.index}}.attributes.{{fa.index}}.value" value="{{fa.value}}">
            <input type="hidden" name="system.faces.{{face.index}}.attributes.{{fa.index}}.max" value="{{fa.max}}">
            <input type="hidden" name="system.faces.{{face.index}}.attributes.{{fa.index}}.attr" value="{{fa.attr}}">
          {{/each}}

          {{!-- Per-face linked actor + link mode --}}
          <div class="fe-sp-face-actor-section">
            <div class="fe-sp-face-actor-row">
              <span class="fe-sp-face-actor-drop{{#if face.linkedActorName}} linked{{/if}}"
                    data-face-index="{{face.index}}"
                    {{#if face.linkedActorName}}data-action="feClearFaceLinkedActor"{{/if}}
                    title="{{#if face.linkedActorName}}{{face.linkedActorName}} ({{localize "FESP.Sheet.FaceActorClear"}}){{else}}{{localize "FESP.Sheet.FaceActorDropHint"}}{{/if}}">
                {{#if face.linkedActorName}}<img src="{{face.linkedActorImg}}" alt="">{{else}}<i class="fa-solid fa-user-plus"></i>{{/if}}
              </span>
              {{#if face.linkedActorName}}
                <div class="fe-sp-face-actor-info">
                  <span class="fe-sp-face-actor-name">{{face.linkedActorName}}</span>
                  <select class="fe-sp-face-link-mode" data-face-index="{{face.index}}"
                          name="system.faces.{{face.index}}.linkMode" {{#unless ../fe.editable}}disabled{{/unless}}>
                    <option value="copy" {{#if (eq face.linkMode "copy")}}selected{{/if}}>{{localize "FESP.Sheet.LinkModeCopy"}}</option>
                    <option value="linked" {{#if (eq face.linkMode "linked")}}selected{{/if}}>{{localize "FESP.Sheet.LinkModeLinked"}}</option>
                  </select>
                  <span class="fe-sp-face-actor-clear-hint notes">{{localize "FESP.Sheet.FaceActorClear"}}</span>
                </div>
              {{else}}
                {{!-- Keep every face ArrayField element complete during AppV2
                      auto-submit even while no linked Actor is resolved. --}}
                <input type="hidden" name="system.faces.{{face.index}}.linkMode" value="{{face.linkMode}}">
                <span class="fe-sp-face-actor-drophint">{{localize "FESP.Sheet.FaceActorDropHintBig"}}</span>
              {{/if}}
            </div>
            {{#if face.attrs.length}}
              <ul class="fe-sp-face-attrs">
                {{#each face.attrs as |at|}}
                  <li>
                    <span class="fe-sp-reference-attr-name">{{at.name}}</span>
                    <span class="fe-sp-reference-attr-value">{{at.value}}</span>
                    <code class="fe-sp-attr-path" data-action="feCopyAttrPath" data-path="{{at.path}}"
                          title="{{localize "FESP.Sheet.CustomAttrCopyHint"}}">{{at.path}}</code>
                  </li>
                {{/each}}
              </ul>
            {{/if}}
          </div>

          {{#if face.img}}
          <div class="fe-sp-overlay-section">
            {{! No tooltip on the viewport itself. Core's TooltipManager reads the dataset of
                the element the pointer entered (tooltip-manager.mjs #onActivate) — the stage
                and image cover this box, so it would fire only over the letterboxing, and a
                tooltip over a full-width drag surface is in the way besides. The hint is a
                visible caption under the box instead, which is also where it gets found. }}
            <div class="fe-sp-overlay-preview" data-face-index="{{face.index}}">
              {{! `data-tooltip` takes the raw key: core localizes it when game.i18n.has()
                  matches, and aria-label carries the name for an icon-only button. }}
              <button type="button" class="fe-sp-overlay-view-reset"
                      data-tooltip="FESP.Sheet.PreviewResetView"
                      aria-label="{{localize 'FESP.Sheet.PreviewResetView'}}"><i class="fa-solid fa-arrows-to-dot"></i></button>
              <span class="fe-sp-overlay-zoom"></span>
              {{! The stage is the image, and it is what the markers position against — keep
                  them INSIDE it. Their left/top percentages resolve against the padding box
                  of their containing block, so parenting them to the viewport instead would
                  peg them to the fixed window box rather than to the artwork, and they
                  would neither pan nor zoom with it. }}
              <div class="fe-sp-overlay-stage">
                <img src="{{face.img}}" alt="">
                {{#each face.overlays as |ov|}}
                  {{! WYSIWYG, not a chip: a `.has-preview` marker renders the overlay the way
                      the CANVAS will — canvas typeface/outline, the authored font size scaled
                      by rendered/natural width, and the value bar at its real length, thickness,
                      gap and outline. Every --fe-sp-ov-* number below is in the face image's OWN
                      pixels and is converted by the one cqw formula in the stylesheet, so the
                      preview and `feBarBox` cannot disagree. The chip chrome only comes back on
                      hover, as a drag affordance. `showBar` is the "would the canvas actually
                      paint one" test, so the marker never shows a bar the canvas would skip. }}
                  <div class="fe-sp-overlay-marker{{#if ov.preview}} has-preview{{/if}}{{#if ov.hasBoxW}} has-box-w{{/if}}{{#if ov.hasBoxH}} has-box-h{{/if}}{{#if ov.showBar}} has-bar bar-{{ov.barMode}}{{#if ov.barFixed}} bar-fixed{{/if}}{{#if ov.barBordered}} bar-bordered{{/if}}{{/if}}"
                       data-overlay-index="{{ov.index}}"
                       style="left:{{ov.xPct}}%; top:{{ov.yPct}}%; --fe-sp-ov-box-w:{{ov.boxWidth}}; --fe-sp-ov-box-h:{{ov.boxHeight}};{{#if ov.preview}} color:{{ov.color}}; --fe-sp-ov-font:{{ov.fontSize}};{{/if}}{{#if ov.showBar}} --fe-sp-ov-bar-pct:{{ov.barPct}}%; --fe-sp-ov-bar-color:{{ov.barColor}}; --fe-sp-ov-bar-w:{{ov.barWidth}}; --fe-sp-ov-bar-h:{{ov.barHeight}}; --fe-sp-ov-bar-bw:{{ov.barBorderWidth}}; --fe-sp-ov-bar-bc:{{ov.barBorderColor}};{{/if}}"
                       data-tooltip-text="{{ov.num}}">{{#if ov.showBar}}<span class="fe-sp-overlay-marker-bar"></span>{{/if}}<span class="fe-sp-overlay-marker-text">{{#if ov.preview}}{{ov.preview}}{{else}}{{ov.num}}{{/if}}</span>{{#if ../../fe.editable}}{{! The text-box resize frame: a hover-only rectangle with the usual eight
                        grips. It is a SEPARATE element from the marker on purpose — the
                        marker's own box has to stay the TEXT box, because that is what the
                        value bar is positioned against (feBarBox measures the text, not the
                        frame). Sizing the marker itself would drop an "under" bar to the
                        bottom of the frame while the canvas keeps it under the text. }}<span class="fe-sp-overlay-box-frame"
                        title="{{localize 'FESP.Sheet.OverlayBoxHandleHint'}}"><span class="fe-sp-overlay-box-handle h-nw" data-side="nw"></span><span class="fe-sp-overlay-box-handle h-n" data-side="n"></span><span class="fe-sp-overlay-box-handle h-ne" data-side="ne"></span><span class="fe-sp-overlay-box-handle h-w" data-side="w"></span><span class="fe-sp-overlay-box-handle h-e" data-side="e"></span><span class="fe-sp-overlay-box-handle h-sw" data-side="sw"></span><span class="fe-sp-overlay-box-handle h-s" data-side="s"></span><span class="fe-sp-overlay-box-handle h-se" data-side="se"></span></span>{{/if}}</div>
                {{/each}}
              </div>
            </div>
            <ol class="fe-sp-overlay-rows">
              {{#each face.overlays as |ov|}}
                <li class="fe-sp-overlay-row{{#if ov.attrWarn}} fe-sp-overlay-warn{{/if}}">
                  <span class="fe-sp-overlay-num">{{ov.num}}</span>
                  <span class="fe-sp-overlay-link{{#if ov.linkedActorName}} linked{{/if}}"
                        {{#if ../../fe.editable}}data-action="{{#if ov.linkedActorName}}feClearOverlayLinkedActor{{/if}}"{{/if}}
                        data-face-index="{{face.index}}" data-overlay-index="{{ov.index}}"
                        title="{{#if ov.linkedActorName}}{{ov.linkedActorName}} ({{localize "FESP.Sheet.OverlayLinkClear"}}){{else}}{{localize "FESP.Sheet.OverlayLinkHint"}}{{/if}}">
                    {{#if ov.linkedActorName}}<img src="{{ov.linkedActorImg}}" alt="">{{else}}<i class="fa-solid fa-link-slash"></i>{{/if}}
                  </span>
                  {{!-- The attribute path lives in the 설정 dialog (feEditOverlay) next to the
                        other styling fields, with the datalist picker built there. It stays a
                        hidden input HERE because the faces-array auto-submit resets any field
                        with no input in the form — see the ArrayField rule in CLAUDE.md. --}}
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.attr" value="{{ov.attr}}">
                  {{#if ov.attrWarn}}
                    <i class="fa-solid fa-triangle-exclamation fe-sp-overlay-warn-icon"
                       title="{{ov.attrWarnReason}}"></i>
                  {{/if}}
                  <input type="text" name="system.faces.{{face.index}}.overlays.{{ov.index}}.text"
                         value="{{ov.text}}" placeholder="{{localize "FESP.Sheet.OverlayTextPh"}}"
                         {{#unless ../../fe.editable}}disabled{{/unless}}>
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.x" value="{{ov.x}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.y" value="{{ov.y}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.linkedActorUuid" value="{{ov.linkedActorUuid}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.fontSize" value="{{ov.fontSize}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.color" value="{{ov.color}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.boxWidth" value="{{ov.boxWidth}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.boxHeight" value="{{ov.boxHeight}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.bar" value="{{ov.bar}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.barMin" value="{{ov.barMin}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.barMax" value="{{ov.barMax}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.barMode" value="{{ov.barMode}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.barWidth" value="{{ov.barWidth}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.barHeight" value="{{ov.barHeight}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.barColor" value="{{ov.barColor}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.barBorderWidth" value="{{ov.barBorderWidth}}">
                  <input type="hidden" name="system.faces.{{face.index}}.overlays.{{ov.index}}.barBorderColor" value="{{ov.barBorderColor}}">
                  {{#if ../../fe.editable}}
                    <a data-action="feEditOverlay" data-face-index="{{face.index}}" data-overlay-index="{{ov.index}}"
                       title="{{localize "FESP.Sheet.OverlayEdit"}}"><i class="fa-solid fa-sliders"></i></a>
                    <a data-action="feRemoveOverlay" data-face-index="{{face.index}}" data-overlay-index="{{ov.index}}"
                       title="{{localize "FESP.Sheet.OverlayRemove"}}"><i class="fa-solid fa-trash"></i></a>
                  {{/if}}
                </li>
              {{/each}}
            </ol>
            {{#if ../fe.editable}}
              <button type="button" class="fe-sp-btn fe-sp-overlay-add" data-action="feAddOverlay" data-face-index="{{face.index}}">
                <i class="fa-solid fa-plus"></i> {{localize "FESP.Sheet.OverlayAdd"}}
              </button>
            {{/if}}
          </div>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>

  {{#if fe.editable}}
    <footer class="fe-sp-footer">
      <button type="button" class="fe-sp-btn fe-sp-place" data-action="fePlaceOnScene" {{#unless fe.faceCount}}disabled{{/unless}}>
        <i class="fa-solid fa-image"></i> {{localize "FESP.Sheet.PlaceOnScene"}}
      </button>
    </footer>
  {{/if}}
</div>
