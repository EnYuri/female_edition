<div class="tab fe-sp-attrs-tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{!-- Everything above the divider belongs to ONE face, so the same face switcher
        as the 면 tab lives here too — otherwise editing face 3's attributes meant
        bouncing to the other tab, switching, and coming back. `feSwitchFace`
        re-renders and AppV2 keeps the active tab, so the user stays put. --}}
  {{#if fe.faceCount}}
    <nav class="fe-sp-face-tabs">
      {{#each fe.faces as |face|}}
        <button type="button" class="fe-sp-face-tab{{#if face.active}} active{{/if}}"
                data-action="feSwitchFace" data-index="{{face.index}}"
                title="{{#if face.name}}{{face.name}}{{else}}{{localize "FESP.Sheet.FaceN" n=face.num}}{{/if}}">
          {{! 이미지가 없는 면도 같은 썸네일 칸을 갖는다 — screen-panel-sheet.hbs 와 동일. }}
          {{#if face.img}}<img class="fe-sp-face-tab-thumb" src="{{face.img}}" alt="">
          {{else}}<span class="fe-sp-face-tab-thumb fe-sp-face-tab-thumb-empty"><i class="fa-regular fa-image"></i></span>{{/if}}
          <span class="fe-sp-face-tab-label">{{#if face.name}}{{face.name}}{{else}}{{localize "FESP.Sheet.FaceN" n=face.num}}{{/if}}</span>
        </button>
      {{/each}}
    </nav>
  {{/if}}

  {{!-- The active face heading must stay above the linked Actor's potentially long
        source-attribute list, so the current context and its actions remain visible. --}}
  <header class="fe-sp-faces-header fe-sp-face-attrs-header">
    <h3>{{localize "FESP.Sheet.FaceAttrs" n=fe.activeFace.num}}{{#if fe.activeFace.name}} — {{fe.activeFace.name}}{{/if}}</h3>
    {{#if fe.editable}}
      <span class="fe-sp-face-attr-actions">
        {{#if fe.activeFace.linkedActorName}}
          <button type="button" class="fe-sp-btn" data-action="feRecopyFaceAttrs" title="{{localize "FESP.Sheet.FaceAttrRecopyHint"}}">
            <i class="fa-solid fa-rotate"></i> {{localize "FESP.Sheet.FaceAttrRecopy"}}
          </button>
        {{/if}}
        <button type="button" class="fe-sp-btn" data-action="feAddFaceAttr">
          <i class="fa-solid fa-plus"></i> {{localize "FESP.Sheet.FaceAttrAdd"}}
        </button>
      </span>
    {{/if}}
  </header>

  {{!-- The linked Actor is the source for this face's copied attributes, so its
        drop/paste field belongs beside those attributes rather than above the
        face-art overlay preview. Only the active face gets a visible control;
        every face's hidden ArrayField values remain in screen-panel-sheet.hbs. --}}
  {{#if fe.activeFace.hasFace}}
    <div class="fe-sp-face-actor-section">
      <div class="fe-sp-face-actor-row">
        <div class="fe-sp-actor-uuid-field fe-sp-face-actor-drop{{#if fe.activeFace.linkedActorName}} linked{{/if}}"
             data-face-index="{{fe.activeFace.index}}"
             data-current-uuid="{{fe.activeFace.linkedActorUuid}}">
          {{#if fe.activeFace.linkedActorName}}<img src="{{fe.activeFace.linkedActorImg}}" alt="">{{else}}<i class="fa-solid fa-user-plus"></i>{{/if}}
          <input type="text" class="fe-sp-actor-uuid-input" value="{{fe.activeFace.linkedActorUuid}}"
                 placeholder="{{localize "FESP.Sheet.FaceActorDropHintBig"}}"
                 aria-label="{{localize "FESP.Sheet.ActorUuidLabel"}}"
                 autocomplete="off" spellcheck="false" {{#unless fe.editable}}disabled{{/unless}}>
          {{#if fe.activeFace.linkedActorName}}
            <span class="fe-sp-actor-uuid-name" title="{{fe.activeFace.linkedActorName}}">{{fe.activeFace.linkedActorName}}</span>
          {{/if}}
        </div>
        {{#if fe.activeFace.linkedActorName}}
          <div class="fe-sp-face-actor-info">
            <span class="fe-sp-face-actor-name">{{fe.activeFace.linkedActorName}}</span>
            <select class="fe-sp-face-link-mode" data-face-index="{{fe.activeFace.index}}"
                    {{#unless fe.editable}}disabled{{/unless}}>
              <option value="copy" {{#if (eq fe.activeFace.linkMode "copy")}}selected{{/if}}>{{localize "FESP.Sheet.LinkModeCopy"}}</option>
              <option value="linked" {{#if (eq fe.activeFace.linkMode "linked")}}selected{{/if}}>{{localize "FESP.Sheet.LinkModeLinked"}}</option>
            </select>
            <span class="fe-sp-face-actor-clear-hint notes">{{localize "FESP.Sheet.FaceActorClear"}}</span>
          </div>
        {{/if}}
      </div>
    </div>
  {{/if}}

  {{!-- Per-face attributes (copied from the active face's linked actor) --}}
  {{#if fe.activeFace.linkedActorName}}
    <p class="notes">{{localize "FESP.Sheet.FaceAttrLinkedNote" actor=fe.activeFace.linkedActorName}}</p>
  {{else}}
    <p class="notes">{{localize "FESP.Sheet.FaceAttrNoLink"}}</p>
  {{/if}}

  {{#if fe.activeFace.attrCount}}
    <ol class="fe-sp-attr-rows">
      {{#each fe.activeFace.commonAttrs as |fa|}}
        <li class="fe-sp-attr-row fe-sp-face-attr-row">
          <input type="text" class="fe-sp-attr-name fe-sp-face-attr-input" value="{{fa.name}}"
                 data-face-index="{{../fe.activeFace.index}}" data-attr-index="{{fa.index}}" data-field="name"
                 placeholder="{{localize "FESP.Sheet.CustomAttrNamePh"}}" {{#unless ../fe.editable}}disabled{{/unless}}>
          <input type="text" class="fe-sp-attr-value fe-sp-face-attr-input" value="{{fa.value}}"
                 data-face-index="{{../fe.activeFace.index}}" data-attr-index="{{fa.index}}" data-field="value"
                 placeholder="{{localize "FESP.Sheet.CustomAttrValuePh"}}" {{#unless ../fe.editable}}disabled{{/unless}}>
          <span class="fe-sp-attr-sep">/</span>
          <input type="text" class="fe-sp-attr-max fe-sp-face-attr-input" value="{{fa.max}}"
                 data-face-index="{{../fe.activeFace.index}}" data-attr-index="{{fa.index}}" data-field="max"
                 placeholder="{{localize "FESP.Sheet.CustomAttrMaxPh"}}" {{#unless ../fe.editable}}disabled{{/unless}}>
          {{#if fa.attr}}
            <code class="fe-sp-attr-path" data-action="feCopyAttrPath" data-path="{{fa.attr}}"
                  title="{{localize "FESP.Sheet.CustomAttrCopyHint"}}">{{fa.attr}}</code>
          {{/if}}
          {{#if ../fe.editable}}
            <a data-action="feRemoveFaceAttr" data-face-index="{{../fe.activeFace.index}}" data-index="{{fa.index}}"
               title="{{localize "FESP.Sheet.CustomAttrRemove"}}"><i class="fa-solid fa-trash"></i></a>
          {{/if}}
        </li>
      {{/each}}
    </ol>
    {{#if fe.activeFace.otherAttrs.length}}
      <details class="fe-sp-attr-other">
        <summary>{{localize "FESP.Sheet.FaceAttrOther" n=fe.activeFace.otherAttrs.length}}</summary>
        <ol class="fe-sp-attr-rows">
          {{#each fe.activeFace.otherAttrs as |fa|}}
            <li class="fe-sp-attr-row fe-sp-face-attr-row">
              <input type="text" class="fe-sp-attr-name fe-sp-face-attr-input" value="{{fa.name}}"
                     data-face-index="{{../../fe.activeFace.index}}" data-attr-index="{{fa.index}}" data-field="name"
                     placeholder="{{localize "FESP.Sheet.CustomAttrNamePh"}}" {{#unless ../../fe.editable}}disabled{{/unless}}>
              <input type="text" class="fe-sp-attr-value fe-sp-face-attr-input" value="{{fa.value}}"
                     data-face-index="{{../../fe.activeFace.index}}" data-attr-index="{{fa.index}}" data-field="value"
                     placeholder="{{localize "FESP.Sheet.CustomAttrValuePh"}}" {{#unless ../../fe.editable}}disabled{{/unless}}>
              <span class="fe-sp-attr-sep">/</span>
              <input type="text" class="fe-sp-attr-max fe-sp-face-attr-input" value="{{fa.max}}"
                     data-face-index="{{../../fe.activeFace.index}}" data-attr-index="{{fa.index}}" data-field="max"
                     placeholder="{{localize "FESP.Sheet.CustomAttrMaxPh"}}" {{#unless ../../fe.editable}}disabled{{/unless}}>
              {{#if fa.attr}}
                <code class="fe-sp-attr-path" data-action="feCopyAttrPath" data-path="{{fa.attr}}"
                      title="{{localize "FESP.Sheet.CustomAttrCopyHint"}}">{{fa.attr}}</code>
              {{/if}}
              {{#if ../../fe.editable}}
                <a data-action="feRemoveFaceAttr" data-face-index="{{../../fe.activeFace.index}}" data-index="{{fa.index}}"
                   title="{{localize "FESP.Sheet.CustomAttrRemove"}}"><i class="fa-solid fa-trash"></i></a>
              {{/if}}
            </li>
          {{/each}}
        </ol>
      </details>
    {{/if}}
  {{/if}}

  {{!-- Keep the linked Actor's source-path reference after the editable snapshot:
        users first review/change the copied values, then consult paths as needed. --}}
  {{#if fe.activeFace.attrs.length}}
    <ul class="fe-sp-face-attrs">
      {{#each fe.activeFace.attrs as |at|}}
        <li>
          <span class="fe-sp-reference-attr-name">{{at.name}}</span>
          <span class="fe-sp-reference-attr-value">{{at.value}}</span>
          <code class="fe-sp-attr-path" data-action="feCopyAttrPath" data-path="{{at.path}}"
                title="{{localize "FESP.Sheet.CustomAttrCopyHint"}}">{{at.path}}</code>
        </li>
      {{/each}}
    </ul>
  {{/if}}

  <hr class="fe-sp-attr-divider">

  <header class="fe-sp-faces-header fe-sp-custom-attrs-header">
    <h3>{{localize "FESP.Sheet.CustomAttrs"}}</h3>
    {{#if fe.editable}}
      <button type="button" class="fe-sp-btn" data-action="feAddCustomAttr">
        <i class="fa-solid fa-plus"></i> {{localize "FESP.Sheet.CustomAttrAdd"}}
      </button>
    {{/if}}
  </header>
  <p class="notes">{{localize "FESP.Sheet.CustomAttrHint"}}</p>

  <ol class="fe-sp-attr-rows">
    {{#each fe.customAttributes as |ca|}}
      <li class="fe-sp-attr-row">
        <input type="text" class="fe-sp-attr-name" name="system.customAttributes.{{ca.index}}.name"
               value="{{ca.name}}" placeholder="{{localize "FESP.Sheet.CustomAttrNamePh"}}"
               {{#unless ../fe.editable}}disabled{{/unless}}>
        <input type="text" class="fe-sp-attr-value" name="system.customAttributes.{{ca.index}}.value"
               value="{{ca.value}}" placeholder="{{localize "FESP.Sheet.CustomAttrValuePh"}}"
               {{#unless ../fe.editable}}disabled{{/unless}}>
        <span class="fe-sp-attr-sep">/</span>
        <input type="text" class="fe-sp-attr-max" name="system.customAttributes.{{ca.index}}.max"
               value="{{ca.max}}" placeholder="{{localize "FESP.Sheet.CustomAttrMaxPh"}}"
               {{#unless ../fe.editable}}disabled{{/unless}}>
        {{!-- MUST end in `.value` (or `.max`). An overlay resolves `attr` with a plain
              getProperty, so `system.customAttributes.0` hands back the {name,value,max}
              OBJECT and the canvas renders "[object Object]". --}}
        <code class="fe-sp-attr-path" data-action="feCopyAttrPath" data-path="system.customAttributes.{{ca.index}}.value"
              title="{{localize "FESP.Sheet.CustomAttrCopyHint"}}">system.customAttributes.{{ca.index}}.value</code>
        {{#if ../fe.editable}}
          <a data-action="feRemoveCustomAttr" data-index="{{ca.index}}" title="{{localize "FESP.Sheet.CustomAttrRemove"}}">
            <i class="fa-solid fa-trash"></i>
          </a>
        {{/if}}
      </li>
    {{/each}}
  </ol>
</div>
