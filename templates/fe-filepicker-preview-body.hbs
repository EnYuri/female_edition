{{!--
  female_edition: FilePicker 미리보기 본문 (_writePreview).

  url 과 name 은 반드시 이스케이프되어야 한다 — 이름에 큰따옴표가 든 파일은
  (Linux/macOS 호스트에서 허용되고, 플레이어가 올린 파일은 GM 이 미리보기를 여는
  순간 크로스유저 벡터가 된다) src="" 를 빠져나와 onerror 를 주입할 수 있다.
  Handlebars 의 {{ }} 가 & < > " ' 를 모두 이스케이프하므로 별도 esc 헬퍼가 필요 없다.
  절대 {{{ }}} 로 바꾸지 말 것.
--}}
<div class="fe-fp-stage" data-fe-stage>
  {{#if isImage}}
  <img class="fe-fp-media" src="{{url}}" alt="{{name}}" data-fe-media>
  {{else if isVideo}}
  <video class="fe-fp-media" src="{{url}}" controls preload="metadata" data-fe-media></video>
  {{else if isAudio}}
  <div class="fe-fp-audio-wrap">
    <i class="fa-solid fa-music" inert></i>
    <audio src="{{url}}" controls preload="metadata" data-fe-media></audio>
  </div>
  {{else if isFont}}
  <div class="fe-fp-font" data-fe-font>
    {{localize "FE.FontPreview.Sample"}}<br>
    <span class="fe-fp-font-sm">{{localize "FE.FontPreview.Pangram"}}</span>
  </div>
  {{else}}
  <div class="fe-fp-fileicon"><i class="{{icon}}" inert></i></div>
  {{/if}}
</div>
<div class="fe-fp-meta">
  <div class="fe-fp-name" title="{{name}}">{{name}}</div>
  <div class="fe-fp-sub" data-fe-sub>{{sub}}</div>
  <div class="fe-fp-dim" data-fe-dim></div>
</div>
