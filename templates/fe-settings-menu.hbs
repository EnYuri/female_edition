    <div class="form-group">
      <label>{{localize "FE.SettingsMenu.ceCoreUiSceneConfigTabs.Text"}}</label>
      <div class="form-fields"><input type="checkbox" name="ceCoreUiSceneConfigTabs" data-dtype="Boolean" {{checked values.ceCoreUiSceneConfigTabs}} /></div>
      <p class="notes">{{{localize "FE.SettingsMenu.ceCoreUiSceneConfigTabs.Hint"}}}</p>
