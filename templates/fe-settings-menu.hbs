        <input type="checkbox" name="cePruneEnabled" data-dtype="Boolean" {{checked values.cePruneEnabled}} />
      </div>
      <p class="notes">{{localize "FE.SettingsMenu.cePruneEnabled.Text"}}</p>
    </div>

    <div class="form-group">
      <label>{{localize "FE.SettingsMenu.cePruneMaxMessages.Text"}}</label>
      <div class="form-fields">
        <input type="number" name="cePruneMaxMessages" data-dtype="Number" value="{{values.cePruneMaxMessages}}" step="{{ranges.cePruneMaxMessages.step}}" min="{{ranges.cePruneMaxMessages.min}}" max="{{ranges.cePruneMaxMessages.max}}" />
      </div>
      <p class="notes">{{localize "FE.SettingsMenu.cePruneMaxMessages.Text2"}}</p>
