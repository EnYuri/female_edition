{{!-- The <form> must be inside the template (not tag:"form") so that v13 AppV2's
     querySelector("form") can find it. A Handlebars part must render a SINGLE
     root element, so the <form> IS that root element. --}}
<form class="fe-settings">
  <div class="fe-settings__topbar flexrow">
    <div class="fe-settings__title">
      <h2>{{localize "FE.Settings.Title"}}</h2>
    </div>

  </div>

  {{#if warnings.chatPortraitDup}}
  <div class="fe-settings__warning">
    <p>{{{localize "FE.SettingsMenu.General.Hint"}}}</p>
    <p class="notes">{{localize "FE.SettingsMenu.General.Text"}}</p>
  </div>
  {{/if}}

  <nav class="fe-settings__tabs" role="tablist" aria-label="{{localize "FE.SettingsMenu.General.Text2"}}">
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="general">{{localize "FE.SettingsMenu.Tabs.General"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="chat-functions">{{localize "FE.SettingsMenu.Tabs.ChatFunctions"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="chat-appearance">{{localize "FE.SettingsMenu.Tabs.ChatAppearance"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="chat-features">{{localize "FE.SettingsMenu.Tabs.ChatMerge"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="portrait">{{localize "FE.Common.ChatPortrait"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="archive">{{localize "FE.Common.ChatArchive"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="system">{{localize "FE.SettingsMenu.Tabs.Interface"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="media">{{localize "FE.SettingsMenu.Tabs.Images"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="music">{{localize "FE.SettingsMenu.Tabs.Music"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="combat-tracker">{{localize "FE.Common.CombatTracker"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="stage">{{localize "FE.SettingsMenu.Tabs.Stage"}}</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="canvas">{{localize "FE.SettingsMenu.Tabs.Canvas"}}</button>
  </nav>

  <section class="fe-settings__section" data-fe-settings-tab="chat-functions">
    <h3 class="fe-settings__section-title">{{localize "FE.SettingsMenu.Tabs.ChatFunctions"}}</h3>

    <div class="form-group">
      <label>{{localize "FE.SettingsData.ceMarkdownEnabled.name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="ceMarkdownEnabled" data-dtype="Boolean" {{checked values.ceMarkdownEnabled}} />
      </div>
    </div>

    <div class="form-group">
      <label>{{localize "FE.SettingsMenu.ceEditEnabled.Text"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="ceEditEnabled" data-dtype="Boolean" {{checked values.ceEditEnabled}} />
      </div>
    </div>
  </section>

  <section class="fe-settings__section" data-fe-settings-tab="chat-functions">
    <h3 class="fe-settings__section-title">{{localize "FE.SettingsMenu.chatFunctions.Text"}}</h3>

    <div class="form-group">
      <label>{{localize "FE.SettingsData.cePruneEnabled.name"}}</label>
