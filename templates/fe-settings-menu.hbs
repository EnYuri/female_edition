{{!-- The <form> must be inside the template (not tag:"form") so that v13 AppV2's
     querySelector("form") can find it. A Handlebars part must render a SINGLE
     root element, so the <form> IS that root element. --}}
<form class="fe-settings">
  <div class="fe-settings__topbar flexrow">
    <div class="fe-settings__title">
      <h2>Female-cupwhi 설정</h2>
    </div>

  </div>

  {{#if warnings.chatPortraitDup}}
  <div class="fe-settings__warning">
    <p><b>경고:</b> 외부 모듈 <code>chat-portrait</code> 가 활성화되어 있습니다. 이 모듈의 <b>채팅 포트레이트</b> 기능과 중복 표시될 수 있습니다.</p>
    <p class="notes">중복이 보이면 둘 중 하나를 끄세요.</p>
  </div>
  {{/if}}

  <nav class="fe-settings__tabs" role="tablist" aria-label="설정 분류">
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="general">일반</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="chat-functions">채팅 기능</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="chat-appearance">채팅 외형</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="chat-features">채팅 병합</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="portrait">채팅 포트레이트</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="archive">채팅 아카이브</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="system">인터페이스</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="media">이미지</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="music">음악</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="combat-tracker">컴뱃 트래커</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="stage">무대 채팅</button>
    <button type="button" class="fe-settings__tab" role="tab" data-fe-settings-tab-button="canvas">토큰·패널</button>
  </nav>

  <section class="fe-settings__section" data-fe-settings-tab="combat-tracker"></section>

  <section class="fe-settings__section" data-fe-settings-tab="chat-functions">
    <h3 class="fe-settings__section-title">채팅 기능</h3>

    <div class="form-group">
      <label>채팅 입력 마크다운 지원</label>
      <div class="form-fields">
        <input type="checkbox" name="ceMarkdownEnabled" data-dtype="Boolean" {{checked values.ceMarkdownEnabled}} />
      </div>
    </div>

    <div class="form-group">
      <label>채팅 수정(편집) 기능</label>
      <div class="form-fields">
        <input type="checkbox" name="ceEditEnabled" data-dtype="Boolean" {{checked values.ceEditEnabled}} />
      </div>
    </div>
  </section>

  <section class="fe-settings__section" data-fe-settings-tab="chat-functions">
    <h3 class="fe-settings__section-title">채팅 DOM 정리</h3>

    <div class="form-group">
      <label>채팅 DOM 정리(성능 최적화)</label>
      <div class="form-fields">
        <input type="checkbox" name="cePruneEnabled" data-dtype="Boolean" {{checked values.cePruneEnabled}} />
      </div>
      <p class="notes">오래된 메시지를 DOM에서 제거해 성능을 개선합니다. 위로 스크롤하면 다시 불러옵니다. (변경 후 새로고침 필요)</p>
    </div>

    <div class="form-group">
      <label>DOM 정리: 최대 유지 메시지 수</label>
      <div class="form-fields">
        <input type="number" name="cePruneMaxMessages" data-dtype="Number" value="{{values.cePruneMaxMessages}}" step="10" min="20" max="200" />
      </div>
      <p class="notes">이 수를 초과하면 오래된 메시지를 제거합니다. 스크롤 1회에 이 값의 절반만큼 불러옵니다. (즉시 적용, 기본값: 60)</p>
    </div>
  </section>

  <section class="fe-settings__section" data-fe-settings-tab="chat-functions">
    <h3 class="fe-settings__section-title">타이핑 인디케이터</h3>

    <div class="form-group">
      <label>타이핑 인디케이터 표시('…님이 입력 중')</label>
      <div class="form-fields">
        <input type="checkbox" name="ceTypingEnabled" data-dtype="Boolean" {{checked values.ceTypingEnabled}} />
      </div>
      <p class="notes">다른 사용자가 입력 중일 때 입력창 위에 표시합니다. CautiousGamemastersPack(CGMP)이 활성화되어 있으면 자동으로 비활성화되어 CGMP에 양보합니다.</p>
    </div>

    {{#if isGM}}
    <div class="form-group">
      <label>타이핑 인디케이터: 플레이어에게도 표시</label>
      <div class="form-fields">
        <input type="checkbox" name="ceTypingShowToPlayers" data-dtype="Boolean" {{checked values.ceTypingShowToPlayers}} />
      </div>
      <p class="notes">끄면 GM만 다른 사용자의 입력 중 표시를 볼 수 있습니다. (월드 설정 — GM 전용)</p>
    </div>
    {{/if}}
  </section>

  <section class="fe-settings__section" data-fe-settings-tab="general">
    <h3 class="fe-settings__section-title">폰트</h3>

    <div class="form-group">
      <label>커스텀 폰트 적용 (쿠키런/그림일기, 개인)</label>
      <div class="form-fields">
        <input type="checkbox" name="enableFonts" data-dtype="Boolean" {{checked values.enableFonts}} />
      </div>
      <p class="notes">이 모듈의 커스텀 폰트(CookieRun/그림일기) 및 관련 옵션을 활성화합니다. 항상 개인 유지되며 GM 설정 강제 대상이 아닙니다.</p>
    </div>

    <div class="form-group">
      <label>유저(로컬) 폰트 사용</label>
      <div class="form-fields">
        <input type="checkbox" name="ceUiUseUserFont" data-dtype="Boolean" {{checked values.ceUiUseUserFont}} />
      </div>
      <p class="notes">컴퓨터에 설치된 폰트 또는 모듈 font 폴더의 폰트를 채팅·UI 전체에 적용합니다(NeoDGM처럼 전부 교체). 켜면 아래 '채팅 글꼴 선택'(모듈 폰트) 대신 '유저 폰트 선택'이 사용됩니다. 항상 개인 유지되며 GM 설정 강제 대상이 아닙니다.</p>
    </div>

    <div class="form-group fe-module-font-row">
      <label>채팅 글꼴 선택</label>
      <div class="form-fields">
        <select name="ceChatFontChoice" data-dtype="String">
          {{selectOptions choices.chatFontChoice selected=values.ceChatFontChoice}}
        </select>
      </div>
      <p class="notes">'쿠키런 + 그림일기'는 큰 글자/강조=쿠키런, 작은 글자 및 UI/시트 기본 글꼴=그림일기로 섞어 씁니다. 다른 항목은 채팅·UI·시트를 해당 글꼴로 통일합니다. (커스텀 폰트 적용이 켜져 있어야 합니다)</p>
    </div>

    <div class="form-group fe-user-font-row">
      <label>유저 폰트 선택</label>
      <div class="form-fields fe-user-font-fields">
        <select class="fe-user-font-picker">
          <option value="">— 목록에서 선택 —</option>
          {{#if userFontModuleList.length}}
          <optgroup label="모듈 font 폴더">
            {{#each userFontModuleList}}
            <option value="{{this.family}}">{{this.label}}</option>
            {{/each}}
          </optgroup>
          {{/if}}
          <optgroup class="fe-user-font-system-group" label="설치된 시스템 폰트"></optgroup>
        </select>
        <button type="button" class="fe-load-system-fonts">시스템 폰트 불러오기</button>
      </div>
      <div class="form-fields">
        <input type="text" name="ceUserFontFamily" data-dtype="String" value="{{values.ceUserFontFamily}}" placeholder="폰트 패밀리 이름 (예: Malgun Gothic)" />
      </div>
      <div class="fe-user-font-preview">다람쥐 헌 쳇바퀴에 타고파 — ABCabc XYZ 0123 가나다라마바사</div>
      <p class="notes">목록에서 고르거나 폰트 패밀리 이름을 직접 입력하세요(아래 입력칸 값이 실제 적용값). '시스템 폰트 불러오기'는 설치된 폰트 목록을 채워 줍니다 — 브라우저 권한 허용이 한 번 필요할 수 있습니다.{{#unless localFontsSupported}} 이 환경은 자동 목록을 지원하지 않아 직접 입력 또는 모듈 폴더 폰트만 사용할 수 있습니다.{{/unless}}</p>
    </div>


  </section>

  <section class="fe-settings__section" data-fe-settings-tab="system">
    <h3 class="fe-settings__section-title">인터페이스</h3>

    <div class="form-group">
      <label>화면 좌상단 컨트롤 접기(드롭다운, 개인)</label>
      <div class="form-fields">
        <input type="checkbox" name="ceSceneControlsCollapse" data-dtype="Boolean" {{checked values.ceSceneControlsCollapse}} />
      </div>
      <p class="notes">레이어/도구 줄을 평소엔 현재 선택된 1칸만 보이게 접습니다. 칸을 클릭하면 펼쳐지고, 항목을 고르면 다시 접힙니다. 바깥 클릭/Esc로도 접힙니다. 항상 개인 유지되며 GM 설정 강제 대상이 아닙니다.</p>
    </div>

    <div class="form-group">
      <label>어트리뷰트 이름 도우미(마우스 호버)</label>
      <div class="form-fields">
        <input type="checkbox" name="ceAttrPathHelper" data-dtype="Boolean" {{checked values.ceAttrPathHelper}} />
      </div>
      <p class="notes">시트나 채팅에 표시된 값 위에 마우스를 올리면 그 시스템 어트리뷰트 이름(예: system.attributes.init.value)을 툴팁으로 표시합니다. 기존 툴팁이 있으면 그 아래 줄에 덧붙고, 없으면 단독 툴팁으로 보입니다. 값은 표시하지 않습니다. dnd5e·dx3rd 공용 점검 도구입니다. GM 설정 강제가 켜져 있으면 GM 값으로 통일됩니다.</p>
    </div>

    <div class="form-group">
      <label>어트리뷰트 이름 도우미: 소스 함께 표시</label>
      <div class="form-fields">
        <input type="checkbox" name="ceAttrPathHelperSource" data-dtype="Boolean" {{checked values.ceAttrPathHelperSource}} />
      </div>
      <p class="notes">이름이 읽힌 출처(예: name, data-property)를 이름 아래에 함께 표시합니다.</p>
    </div>

    <div class="form-group">
      <label>토큰 설정 미리보기</label>
      <div class="form-fields"><input type="checkbox" name="ceCoreUiTokenPreview" data-dtype="Boolean" {{checked values.ceCoreUiTokenPreview}} /></div>
      <p class="notes">프로토타입 토큰 비주얼 탭의 격자·앵커 라이브 미리보기와 조절 슬라이더를 표시합니다. 새로 여는 토큰 설정 창부터 반영됩니다.</p>
    </div>

    <div class="form-group">
      <label>파일 픽커 미리보기 및 개선</label>
      <div class="form-fields"><input type="checkbox" name="ceCoreUiFilepickerEnhancements" data-dtype="Boolean" {{checked values.ceCoreUiFilepickerEnhancements}} /></div>
      <p class="notes">파일 픽커의 미리보기·드롭 업로드 영역과 이름·날짜·크기 정렬을 표시합니다. 새로 여는 파일 픽커부터 반영됩니다.</p>
    </div>

    <div class="form-group">
      <label>토큰 설정: 다른 탭 2열 정렬</label>
      <div class="form-fields">
        <input type="checkbox" name="ceTokenConfigTwoColumn" data-dtype="Boolean" {{checked values.ceTokenConfigTwoColumn}} />
      </div>
      <p class="notes">토큰 미리보기로 넓어진 프로토타입 토큰 설정 창에서, 비주얼 탭이 아닌 탭도 좌우 2열로 정렬합니다. 끄면 Foundry 기본 1열 정렬로 표시합니다.</p>
    </div>

  </section>

  <section class="fe-settings__section" data-fe-settings-tab="chat-appearance">
    <h3 class="fe-settings__section-title">채팅 외형</h3>

    <div class="form-group">
      <label>채팅 카드 텍스쳐 제거</label>
      <div class="form-fields">
        <input type="checkbox" name="stripChatTextures" data-dtype="Boolean" {{checked values.stripChatTextures}} />
      </div>
      <p class="notes">채팅 카드의 parchment/texture 배경 이미지를 제거합니다. 평면 미색 오버레이는 아래에서 별도로 선택합니다.</p>
    </div>

    <div class="form-group">
      <label>페이퍼 톤 오버레이</label>
      <div class="form-fields">
        <input type="checkbox" name="cePaperOverlayEnabled" data-dtype="Boolean" {{checked values.cePaperOverlayEnabled}} />
      </div>
      <p class="notes">텍스쳐 제거 시 평면 미색 오버레이를 추가해 채도를 낮춥니다. 기본값은 꺼짐입니다.</p>
    </div>

    <div class="form-group">
      <label>페이퍼 톤 오버레이 농도</label>
      <div class="form-fields">
        <input type="number" name="ceMessageBgSaturation" data-dtype="Number" value="{{values.ceMessageBgSaturation}}" step="0.01" min="0.05" max="1" />
      </div>
      <p class="notes">위 오버레이를 켰을 때만 사용합니다. 값이 높을수록 더 밝고 채도가 약해집니다.</p>
    </div>

    <div class="form-group">
      <label>채팅 메시지 배경: 유저 색상 적용</label>
      <div class="form-fields">
        <input type="checkbox" name="ceUseUserColorBg" data-dtype="Boolean" {{checked values.ceUseUserColorBg}} />
      </div>
      <p class="notes">각 메시지 배경을 화자(액터 소유자/작성자)의 유저 색상으로 틴트합니다.</p>
    </div>

    <div class="form-group">
      <label>채팅카드 하부 배경(불투명)</label>
      <div class="form-fields">
        <select name="ceUserColorBgBase" data-dtype="String">
          {{selectOptions choices.userColorBgBase selected=values.ceUserColorBgBase}}
        </select>
      </div>
      <p class="notes">채팅카드에 불투명한 배경(흰색/검정/사용자 지정)을 깔아 가독성을 높입니다. 위의 '유저 색상 적용' 틴트와 독립적으로 동작하므로, 틴트가 꺼져 있어도 단독으로 적용됩니다.</p>
    </div>

    <div class="form-group">
      <label>채팅카드 하부 배경: 사용자 지정 색</label>
      <div class="form-fields">
        <input type="color" name="ceUserColorBgCustom" value="{{values.ceUserColorBgCustom}}" />
      </div>
      <p class="notes">위에서 '사용자 지정 색상'을 선택했을 때 사용할 하부 배경색.</p>
    </div>

    <div class="form-group">
      <label>유저 색상 틴트 농도</label>
      <div class="form-fields">
        <input type="number" name="ceUserColorAlpha" data-dtype="Number" value="{{values.ceUserColorAlpha}}" step="0.01" min="0.05" max="0.6" />
      </div>
      <p class="notes">유저 색상이 배경에 입혀지는 진하기(0.05~0.6). 값이 클수록 진해집니다.</p>
    </div>

    <div class="form-group">
      <label>시스템 메시지에도 GM 유저 색상 틴트 적용</label>
      <div class="form-fields">
        <input type="checkbox" name="ceSystemMsgColor" data-dtype="Boolean" {{checked values.ceSystemMsgColor}} />
      </div>
      <p class="notes">화자(캐릭터)가 없는 시스템 메시지에 GM의 유저 색상과 틴트 농도를 적용합니다. 내레이터 채팅(/narrate·/describe·/note)은 제외됩니다.</p>
    </div>

    <div class="form-group">
      <label>시스템 메시지 하부 배경색 적용</label>
      <div class="form-fields">
        <input type="checkbox" name="ceSystemMsgBgEnabled" data-dtype="Boolean" {{checked values.ceSystemMsgBgEnabled}} />
      </div>
      <p class="notes">화자 없는 시스템 메시지에 불투명한 하부 배경색을 적용합니다.</p>
    </div>

    <div class="form-group">
      <label>시스템 메시지 하부 배경색</label>
      <div class="form-fields">
        <input type="color" name="ceSystemMsgBgColor" value="{{values.ceSystemMsgBgColor}}" />
      </div>
      <p class="notes">위 옵션이 켜져 있을 때 사용할 하부 배경색입니다.</p>
    </div>

    <div class="form-group">
      <label>일반 메시지 카드·글씨 색 강제 정의</label>
      <div class="form-fields">
        <input type="checkbox" name="ceForceNormalMsgColor" data-dtype="Boolean" {{checked values.ceForceNormalMsgColor}} />
      </div>
      <p class="notes">일반 메시지(특수 메시지·유저 색상 제외)의 카드 배경·글씨 색을 시스템/테마 기본값으로 강제합니다. Carolingian UI 등 채팅을 통째로 다시 칠하는 모듈이 일반 메시지를 덮어써 가독성이 떨어질 때 되돌립니다.</p>
    </div>

    <div class="form-group">
      <label>채팅: 병합 그룹 외곽선</label>
      <div class="form-fields">
        <input type="checkbox" name="ceChatGroupOutline" data-dtype="Boolean" {{checked values.ceChatGroupOutline}} />
      </div>
      <p class="notes">병합된 메시지 그룹(또는 단일 메시지)을 외곽선(유저 색상)으로 감싸 박스처럼 표시합니다. 끄면 색조 배경만 사용합니다.</p>
    </div>

    <div class="form-group">
      <label>채팅 기본 포트레이트 숨김(내부/기본)</label>
      <div class="form-fields">
        <input type="checkbox" name="hideChatPortraits" data-dtype="Boolean" {{checked values.hideChatPortraits}} />
      </div>
      <p class="notes">채팅 카드 헤더의 기본 아바타/포트레이트를 숨깁니다. (이 모듈이 삽입하는 포트레이트는 별도 옵션)</p>
    </div>

    <div class="form-group">
      <label>채팅: 메시지 카드 간격(px)</label>
      <div class="form-fields">
