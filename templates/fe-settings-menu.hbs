      <div class="form-fields">
        <input type="checkbox" name="ceCanvasDrawingFont" data-dtype="Boolean" {{checked values.ceCanvasDrawingFont}} />
      </div>
      <p class="notes">{{localize "FE.SettingsMenu.ceCanvasDrawingFont.Text"}}</p>
