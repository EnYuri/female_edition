      <div class="form-fields">
        <input type="checkbox" name="ceUiUseUserFont" data-dtype="Boolean" {{checked values.ceUiUseUserFont}} />
      </div>
      <p class="notes">{{localize "FE.SettingsMenu.ceUiUseUserFont.Text"}}</p>
    </div>

    <div class="form-group fe-module-font-row">
      <label>{{localize "FE.SettingsMenu.ceChatFontChoice.Text"}}</label>
      <div class="form-fields">
        <select name="ceChatFontChoice" data-dtype="String">
          {{selectOptions choices.chatFontChoice selected=values.ceChatFontChoice localize=true}}
        </select>
      </div>
      <p class="notes">{{localize "FE.SettingsMenu.ceChatFontChoice.Text2"}}</p>
    </div>

    <div class="form-group fe-user-font-row">
      <label>{{localize "FE.SettingsMenu.ceUserFontFamily.Text"}}</label>
      <div class="form-fields fe-user-font-fields">
        <select class="fe-user-font-picker">
          <option value="">{{localize "FE.SettingsMenu.ceUserFontFamily.Text2"}}</option>
          {{#if userFontModuleList.length}}
          <optgroup label="{{localize "FE.FontPreview.ModuleFolder"}}">
            {{#each userFontModuleList}}
            <option value="{{this.family}}">{{this.label}}</option>
            {{/each}}
          </optgroup>
          {{/if}}
          <optgroup class="fe-user-font-system-group" label="{{localize "FE.FontPreview.SystemFonts"}}"></optgroup>
        </select>
        <button type="button" class="fe-load-system-fonts">{{localize "FE.SettingsMenu.ceUserFontFamily.Text3"}}</button>
      </div>
      <div class="form-fields">
        <input type="text" name="ceUserFontFamily" data-dtype="String" value="{{values.ceUserFontFamily}}" placeholder="{{localize "FE.SettingsMenu.ceUserFontFamily.Text4"}}" />
      </div>
      <div class="fe-user-font-preview">{{localize "FE.SettingsMenu.ceUserFontFamily.Text5"}}</div>
      <p class="notes">{{localize "FE.SettingsMenu.ceUserFontFamily.Text6"}}{{#unless localFontsSupported}} {{localize "FE.SettingsMenu.ceUserFontFamily.Text7"}}{{/unless}}</p>
