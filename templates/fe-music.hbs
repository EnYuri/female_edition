<section class="fe-music">
  <header class="fe-music__header">
    <div class="fe-music__title">
      <h2>Emanim Music</h2>
      <div class="fe-music__sub">
        <span class="tag">공용 플레이리스트: {{playlistName}}</span>
        {{#if direct}}
          <span class="tag ok">직접 업로드</span>
        {{else if gmOnline}}
          <span class="tag">GM 프록시 업로드</span>
        {{else}}
          <span class="tag warn">GM 오프라인</span>
        {{/if}}
      </div>
    </div>

    <div class="fe-music__actions">
      <button type="button" data-action="stopMusic" title="전체 정지">
        <i class="fa-solid fa-stop"></i>
      </button>
      <button type="button" data-action="refresh" title="새로고침">
        <i class="fa-solid fa-rotate"></i>
      </button>
    </div>
  </header>

  <div class="fe-music__card">
    <h3>업로드</h3>
    <div class="fe-music__row">
      <div class="label">저장 폴더</div>
      <div class="value"><code>{{uploadDir}}</code></div>
    </div>

    <div class="fe-music__drop-zone{{#if uploadDisabled}} is-disabled{{/if}}" data-drop-zone>
      <label class="fe-music__upload-btn">
        <i class="fa-solid fa-cloud-arrow-up"></i>
        <span>{{#if uploadStatusText}}{{uploadStatusText}}{{else}}파일 선택 / 여기에 드롭{{/if}}</span>
        <input type="file" accept="audio/*" data-fe-upload multiple {{#if uploadDisabled}}disabled{{/if}}>
      </label>
      <p class="hint">Ctrl+클릭으로 다중 선택 · 드래그 &amp; 드롭 가능 · 이름+크기가 같은 파일은 중복 없이 재사용</p>
    </div>
  </div>

  <div class="fe-music__card">
    <h3>트랙 목록 (공용)</h3>

    {{#if sounds.length}}
      <ul class="fe-music__list">
        {{#each sounds}}
          <li class="fe-music__item">
            <div class="name">
              {{#if playing}}<i class="fa-solid fa-volume-high"></i>{{else}}<i class="fa-solid fa-music"></i>{{/if}}
              <span>{{name}}</span>
            </div>
            <div class="actions">
              <button type="button" data-action="play" data-sound-id="{{id}}" title="재생">
                <i class="fa-solid fa-play"></i>
              </button>
              <button type="button" data-action="stop" data-sound-id="{{id}}" title="정지">
                <i class="fa-solid fa-stop"></i>
              </button>
              <button type="button" data-action="dj" data-sound-id="{{id}}" title="이 곡만 재생(다른 곡 정지)">
                <i class="fa-solid fa-bolt"></i>
              </button>
              {{#if canDelete}}
              <button type="button" data-action="del" data-sound-id="{{id}}" title="삭제 (GM)">
                <i class="fa-solid fa-trash"></i>
              </button>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="hint">아직 업로드된 트랙이 없습니다.</p>
    {{/if}}
  </div>
</section>
