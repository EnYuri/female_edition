<section class="fe-music">
  <header class="fe-music__header">
    <div class="fe-music__title">
      <h2>Emanim Music</h2>
      <div class="fe-music__sub">
        <span class="tag">{{localize "FE.Music.Text.Text1"}} {{playlistName}}</span>
        {{#if direct}}
          <span class="tag ok">{{localize "FE.Music.Text.Text2"}}</span>
        {{else if gmOnline}}
          <span class="tag">{{localize "FE.Music.Text.Text3"}}</span>
        {{else}}
          <span class="tag warn">{{localize "FE.Music.Text.Text4"}}</span>
        {{/if}}
      </div>
    </div>

    <div class="fe-music__actions">
      <button type="button" data-action="stopMusic" title="{{localize "FE.Music.Text.Text5"}}">
        <i class="fa-solid fa-stop"></i>
      </button>
      <button type="button" data-action="refresh" title="{{localize "FE.Common.Refresh"}}">
        <i class="fa-solid fa-rotate"></i>
      </button>
    </div>
  </header>

  <div class="fe-music__card">
    <h3>{{localize "FE.Music.Text.Text7"}}</h3>
    <div class="fe-music__row">
      <div class="label">{{localize "FE.Music.Text.Text8"}}</div>
      <div class="value"><code>{{uploadDir}}</code></div>
    </div>

    <div class="fe-music__drop-zone{{#if uploadDisabled}} is-disabled{{/if}}" data-drop-zone>
      <label class="fe-music__upload-btn">
        <i class="fa-solid fa-cloud-arrow-up"></i>
        <span>{{#if uploadStatusText}}{{uploadStatusText}}{{else}}{{localize "FE.Music.Text.Text9"}}{{/if}}</span>
        <input type="file" accept="audio/*" data-fe-upload multiple {{#if uploadDisabled}}disabled{{/if}}>
      </label>
      <p class="hint">{{localize "FE.Music.Text.Text10"}}</p>
    </div>
  </div>

  <div class="fe-music__card">
    <h3>{{localize "FE.Music.Text.Text11"}}</h3>

    {{#if sounds.length}}
      <ul class="fe-music__list">
        {{#each sounds}}
          <li class="fe-music__item">
            <div class="name">
              {{#if playing}}<i class="fa-solid fa-volume-high"></i>{{else}}<i class="fa-solid fa-music"></i>{{/if}}
              <span>{{name}}</span>
            </div>
            <div class="actions">
              <button type="button" data-action="play" data-sound-id="{{id}}" title="{{localize "FE.Common.Play"}}">
                <i class="fa-solid fa-play"></i>
              </button>
              <button type="button" data-action="stop" data-sound-id="{{id}}" title="{{localize "FE.Common.Stop"}}">
                <i class="fa-solid fa-stop"></i>
              </button>
              <button type="button" data-action="dj" data-sound-id="{{id}}" title="{{localize "FE.Music.Text.Text14"}}">
                <i class="fa-solid fa-bolt"></i>
              </button>
              {{#if canDelete}}
              <button type="button" data-action="del" data-sound-id="{{id}}" title="{{localize "FE.Music.Text.Text15"}}">
                <i class="fa-solid fa-trash"></i>
              </button>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="hint">{{localize "FE.Music.Text.Text16"}}</p>
    {{/if}}
  </div>
</section>
