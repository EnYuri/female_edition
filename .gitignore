# AI tooling / agent scratch (local-only)
.codex/
.claude/
.devin/
docs/

# NOTE: ci/ is committed (CI runs it) but kept OUT of the distributed
# module.zip via `ci export-ignore` in .gitattributes — Foundry users never
# receive it. Do not add ci/ here.

# Node dev tooling — never shipped (also export-ignore'd) and never committed.
node_modules/

# Markdown docs are local-only — except the repo README
*.md
!README.md

# ...and except licences/attribution for the third-party code vendored under
# tidy-classic/ (Tidy 5e Sheets and the RPG-Awesome icon font). We redistribute
# those files, so their licence text has to ship with them.
!tidy-classic/**/LICENSE.md
!tidy-classic/LICENSE.md
!tidy-classic/NOTICE.md

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Logs & temp
*.log
*.tmp
*.bak
tmp/

# Scratch file left over from lang-key auditing — local only.
tidy-classic/public/tmp_keys.json

#tempzip
*.zip

# Neo둥근모 Pro is retained locally for offline use, but the module now loads
